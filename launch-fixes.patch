+        path="/for-colleges"
+      />
+
+      {/* Hero */}
+      <section className="bg-gradient-to-br from-emerald-50 via-white to-teal-50 pt-36 pb-20">
+        <div className="max-w-5xl mx-auto px-6 text-center">
