+const test = require('node:test');
+const assert = require('node:assert/strict');
+const Module = require('module');
+const crypto = require('crypto');
+
+process.env.JWT_SECRET = 'z'.repeat(40);
+
+// Use the real jsonwebtoken when installed, otherwise a tiny HS256 stand-in that also sets iat.
+const realLoad = Module._load;
+let jwtImpl;
+try { jwtImpl = require('jsonwebtoken'); } catch {
+  const b64 = (o) => Buffer.from(JSON.stringify(o)).toString('base64url');
+  const mac = (d, s) => crypto.createHmac('sha256', s).update(d).digest('base64url');
+  jwtImpl = {
+    sign: (p, s) => { const body = `${b64({ alg: 'HS256' })}.${b64({ ...p, iat: Math.floor(Date.now() / 1000) })}`; return `${body}.${mac(body, s)}`; },
+    verify: (t, s) => { const [h, p, sig] = String(t).split('.'); if (!sig || mac(`${h}.${p}`, s) !== sig) throw new Error('bad'); return JSON.parse(Buffer.from(p, 'base64url').toString()); },
+  };
+}
+Module._load = function (request, ...rest) {
+  if (request === 'jsonwebtoken') return jwtImpl;
+  return realLoad.call(this, request, ...rest);
+};
+
+const { normalizeSet, publicQuestions, signAttempt, verifyAttempt, scoreAttempt } = require('../../utils/campusTest');
+
+const rawQ = (i, correct = 'a') => ({
+  question: `Question ${i}?`,
+  options: { a: `A${i}`, b: `B${i}`, c: `C${i}`, d: `D${i}` },
+  correct_option: correct,
+  explanation: 'because',
+});
+const raw = (n = 10) => Array.from({ length: n }, (_, i) => rawQ(i + 1));
+
+test('normalizeSet keeps the correct answer after shuffling', () => {
+  const set = normalizeSet(raw(), () => 0.3);
+  assert.equal(set.length, 10);
+  set.forEach((q, i) => assert.equal(q.options[q.correct_option], `A${i + 1}`));
+});
+
+test('normalizeSet rejects unusable AI output', () => {
+  assert.equal(normalizeSet(null), null);
+  assert.equal(normalizeSet(raw(9)), null);
+  const dup = raw(); dup[0].options.b = dup[0].options.a;
+  assert.equal(normalizeSet(dup), null);
+  const badLetter = raw(); badLetter[2].correct_option = 'e';
+  assert.equal(normalizeSet(badLetter), null);
+  const empty = raw(); empty[1].options.c = '  ';
+  assert.equal(normalizeSet(empty), null);
+});
+
+test('publicQuestions never exposes answers or explanations', () => {
+  const set = { questions: normalizeSet(raw()) };
+  const shown = JSON.stringify(publicQuestions(set));
+  assert.ok(!shown.includes('correct_option'));
+  assert.ok(!shown.includes('explanation'));
+});
+
+test('scoreAttempt counts only correct answers and ignores junk', () => {
+  const set = { questions: normalizeSet(raw(), () => 0.5) };
+  const answers = {};
+  set.questions.slice(0, 6).forEach((q) => { answers[q.id] = q.correct_option.toUpperCase(); });
+  assert.deepEqual(scoreAttempt(set, answers), { score: 6, total: 10 });
+  assert.deepEqual(scoreAttempt(set, null), { score: 0, total: 10 });
+  assert.deepEqual(scoreAttempt(set, ['a', 'a']), { score: 0, total: 10 });
+});
+
+test('attempt token: too fast, mismatch, invalid and valid', () => {
+  const token = signAttempt({ studentId: 's1', category: 'ms-excel', setId: 'set1' });
+  const now = Date.now();
+  assert.equal(verifyAttempt(token, { studentId: 's1', category: 'ms-excel', nowMs: now }).error, 'too_fast');
+  const later = now + 60_000;
+  const ok = verifyAttempt(token, { studentId: 's1', category: 'ms-excel', nowMs: later });
+  assert.equal(ok.claims.set, 'set1');
+  assert.equal(verifyAttempt(token, { studentId: 's2', category: 'ms-excel', nowMs: later }).error, 'mismatch');
+  assert.equal(verifyAttempt(token, { studentId: 's1', category: 'accounting', nowMs: later }).error, 'mismatch');
+  assert.equal(verifyAttempt('garbage', { studentId: 's1', category: 'ms-excel', nowMs: later }).error, 'invalid');
+});
diff --git a/server/utils/campusTest.js b/server/utils/campusTest.js
new file mode 100644
index 0000000..b3ca96e
--- /dev/null
+++ b/server/utils/campusTest.js
@@ -0,0 +1,67 @@
+// Campus skill test helpers: validate AI output, hide answers, issue/verify attempt tokens, score on the server.
+const jwt = require('jsonwebtoken');
+const { getJwtSecret } = require('../config/jwt');
+
+const LETTERS = ['a', 'b', 'c', 'd'];
+const QUESTIONS_PER_SET = 10;
+const MIN_SECONDS_PER_QUESTION = 2; // faster than this is a script, not a student
+const ATTEMPT_TTL = '2h';
+
+const clean = (v, max = 400) => String(v ?? '').replace(/\s+/g, ' ').trim().slice(0, max);
+
+// Validates raw AI output and returns normalised questions with the options shuffled, or null if unusable.
+const normalizeSet = (raw, rng = Math.random) => {
+  if (!Array.isArray(raw) || raw.length < QUESTIONS_PER_SET) return null;
+  const out = [];
+  for (const item of raw.slice(0, QUESTIONS_PER_SET)) {
+    const opts = item?.options;
+    const correct = String(item?.correct_option || '').toLowerCase();
+    if (!item?.question || !opts || !LETTERS.includes(correct)) return null;
+    const texts = LETTERS.map((l) => clean(opts[l], 200));
+    if (texts.some((t) => !t) || new Set(texts.map((t) => t.toLowerCase())).size !== 4) return null;
+
+    // Shuffle so the right answer is not always in the same position.
+    const order = [0, 1, 2, 3];
+    for (let i = order.length - 1; i > 0; i--) {
+      const j = Math.floor(rng() * (i + 1));
+      [order[i], order[j]] = [order[j], order[i]];
+    }
+    const options = {};
+    order.forEach((from, to) => { options[LETTERS[to]] = texts[from]; });
+    out.push({
+      id: out.length + 1,
+      question: clean(item.question, 500),
+      options,
+      correct_option: LETTERS[order.indexOf(LETTERS.indexOf(correct))],
+      explanation: clean(item.explanation, 500),
+    });
+  }
+  return out;
+};
+
+// What the browser may see: no correct answers, no explanations.
+const publicQuestions = (set) => set.questions.map((q) => ({ id: q.id, question: q.question, options: q.options }));
+
+const signAttempt = ({ studentId, category, setId }) =>
+  jwt.sign({ purpose: 'campus-test', sid: String(studentId), cat: category, set: String(setId) }, getJwtSecret(), { expiresIn: ATTEMPT_TTL });
+
+// Returns the claims, or { error } with a reason the API can map to a status code.
+const verifyAttempt = (token, { studentId, category, questionCount = QUESTIONS_PER_SET, nowMs = Date.now() }) => {
+  let claims;
+  try { claims = jwt.verify(String(token || ''), getJwtSecret()); } catch { return { error: 'invalid' }; }
+  if (claims.purpose !== 'campus-test' || claims.sid !== String(studentId) || claims.cat !== category) return { error: 'mismatch' };
+  if (nowMs - claims.iat * 1000 < questionCount * MIN_SECONDS_PER_QUESTION * 1000) return { error: 'too_fast' };
+  return { claims };
+};
+
+// answers: { "<questionId>": "a" | "b" | "c" | "d" }
+const scoreAttempt = (set, answers) => {
+  const given = answers && typeof answers === 'object' && !Array.isArray(answers) ? answers : {};
+  let score = 0;
+  for (const q of set.questions) {
+    if (String(given[q.id] || '').toLowerCase() === q.correct_option) score += 1;
+  }
+  return { score, total: set.questions.length };
+};
+
+module.exports = { normalizeSet, publicQuestions, signAttempt, verifyAttempt, scoreAttempt, QUESTIONS_PER_SET, MIN_SECONDS_PER_QUESTION };
diff --git a/server/utils/questionBank.js b/server/utils/questionBank.js
new file mode 100644
index 0000000..299f0d7
--- /dev/null
+++ b/server/utils/questionBank.js
@@ -0,0 +1,46 @@
+// Fills and reads the campus question bank. Generation uses the same OpenRouter-backed helper as the other AI features.
+const CampusQuestionSet = require('../models/CampusQuestionSet');
+const { GoogleGenerativeAI } = require('./aiHelper');
+const { getCategory } = require('../config/courseMap');
+const { normalizeSet, QUESTIONS_PER_SET } = require('./campusTest');
+
+const buildPrompt = (label) => `
+You write skill-test questions for Indian college students applying for entry-level jobs.
+Topic: ${label}
+Write exactly ${QUESTIONS_PER_SET} multiple-choice questions. Basic to intermediate level, practical and job-relevant (what a fresher needs in a real office or shop), in simple English. No trick questions, no questions about specific brands' pricing.
+Each question has exactly 4 options and exactly ONE correct option; the wrong options must be plausible and clearly different from each other.
+Return ONLY a JSON array, no markdown. Schema:
+[{"id":1,"question":"...","options":{"a":"...","b":"...","c":"...","d":"..."},"correct_option":"a","explanation":"one short sentence"}]
+Random seed: ${Math.random()}`;
+
+const generateSet = async (categoryKey) => {
+  const cat = getCategory(categoryKey);
+  if (!cat) throw new Error('Unknown category');
+  if (!process.env.OPENROUTER_API_KEY) throw new Error('OPENROUTER_API_KEY is not set');
+  const model = new GoogleGenerativeAI(process.env.OPENROUTER_API_KEY).getGenerativeModel({
+    model: 'gemini-2.5-flash',
+    generationConfig: { responseMimeType: 'application/json', temperature: 0.8 },
+  });
+  const result = await model.generateContent(buildPrompt(cat.label));
+  const text = result.response.text().replace(/```json/g, '').replace(/```/g, '').trim();
+  const questions = normalizeSet(JSON.parse(text));
+  if (!questions) throw new Error('AI returned an unusable question set');
+  return CampusQuestionSet.create({ category: categoryKey, questions });
+};
+
+const inflight = new Map(); // category -> promise, so a rush of students triggers one generation, not hundreds
+
+// Random active set for a category. If the bank is empty, generate one set (shared by everyone waiting).
+const pickSet = async (categoryKey) => {
+  const count = await CampusQuestionSet.countDocuments({ category: categoryKey, active: true });
+  if (count > 0) {
+    const [set] = await CampusQuestionSet.find({ category: categoryKey, active: true }).skip(Math.floor(Math.random() * count)).limit(1);
+    if (set) return set;
+  }
+  if (!inflight.has(categoryKey)) {
+    inflight.set(categoryKey, generateSet(categoryKey).finally(() => inflight.delete(categoryKey)));
+  }
+  return inflight.get(categoryKey);
+};
+
+module.exports = { generateSet, pickSet, buildPrompt };
