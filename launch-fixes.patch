+      .then((res) => {
+        const college = (res.data || []).filter((p) => p.role === 'college' && p.isActive);
+        setPlans(college.sort((a, b) => (a.price || 0) - (b.price || 0)));
+      })
+      .catch(() => {});
+  }, []);
+
+  const startFree = () => trackEvent('generate_lead', { placement: 'for_colleges_cta' });
+
+  return (
+    <div className="bg-white">
