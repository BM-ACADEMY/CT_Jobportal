+                <p className="mt-3 text-sm text-slate-600 leading-relaxed">{f.a}</p>
+              </details>
+            ))}
+          </div>
+        </div>
+      </section>
+
+      {/* Closing CTA */}
+      <section className="py-20">
+        <div className="max-w-3xl mx-auto px-6 text-center">
