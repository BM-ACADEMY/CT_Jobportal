@@ -0,0 +1,69 @@
+// Run with: node --test client/api/__tests__/seo.test.mjs
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+process.env.API_BASE_URL = 'https://api.example.test/api';
+process.env.SITE_URL = 'https://velaivaaipu.in';
+
+const SHELL = '<!doctype html><html><head><meta charset="UTF-8" /><meta name="description" content="old" /><meta property="og:title" content="old" /><link rel="canonical" href="https://velaivaaipu.in/" /><title>old</title></head><body><div id="root"></div></body></html>';
+const OPEN = 'a'.repeat(24);
+const CLOSED = 'b'.repeat(24);
+
+globalThis.fetch = async (url) => {
+  const u = String(url);
+  const ok = (data) => ({ ok: true, status: 200, json: async () => data, text: async () => SHELL });
+  if (u.endsWith('/')) return { ok: true, status: 200, text: async () => SHELL };
+  if (u.includes(`/jobs/${OPEN}`)) return ok({ _id: OPEN, title: 'React <Dev> & "QA"', location: 'Pondicherry', vacancies: 2, description: '<p>Build things</p>', createdAt: '2026-10-01', validThrough: '2026-11-01', jobType: 'Full-time', company: { name: 'Acme', logo: '/uploads/logo.png' }, salary: { min: 300000, max: 500000 } });
+  if (u.includes(`/jobs/${CLOSED}`)) return ok({ _id: CLOSED, closed: true, title: 'Old role', location: 'Chennai', company: { name: 'Acme' } });
+  if (u.includes('/jobs/')) return { ok: false, status: 404, json: async () => ({}) };
+  if (u.includes('sitemap-feed')) return ok({ jobs: [{ id: OPEN, title: 'React Dev', location: 'Pondicherry', updatedAt: '2026-10-02' }], companies: [] });
+  throw new Error(`unexpected fetch ${u}`);
+};
+
+const mkRes = () => {
+  const r = { code: 0, headers: {}, body: '' };
+  r.setHeader = (k, v) => { r.headers[k] = v; };
+  r.status = (c) => { r.code = c; return r; };
+  r.send = (b) => { r.body = b; return r; };
+  return r;
+};
+const call = async (handler, req) => { const res = mkRes(); await handler(req, res); return res; };
+const jobReq = (slug) => ({ query: { slug }, headers: { host: 'velaivaaipu.in' } });
+
+const { default: job } = await import('../job.js');
+const { default: sitemap } = await import('../sitemap.js');
+
+test('open job: JobPosting, canonical slug URL and OG tags are in the raw HTML', async () => {
+  const res = await call(job, jobReq(`react-dev-pondicherry-${OPEN}`));
+  assert.equal(res.code, 200);
+  assert.ok(res.body.includes('"@type":"JobPosting"'));
+  assert.match(res.body, /rel="canonical" href="https:\/\/velaivaaipu\.in\/job\/react-dev-qa-pondicherry-a{24}"/);
+  assert.match(res.body, /og:image" content="https:\/\/api\.example\.test\/uploads\/logo\.png"/);
+  assert.equal((res.body.match(/rel="canonical"/g) || []).length, 1);
+  assert.ok(!res.body.includes('content="old"'));
+});
+
+test('job text is HTML-escaped in tags', async () => {
+  const res = await call(job, jobReq(OPEN));
+  assert.ok(res.body.includes('React &lt;Dev&gt; &amp; &quot;QA&quot;'));
+});
+
+test('closed job stays reachable (200), is noindex and has no JobPosting', async () => {
+  const res = await call(job, jobReq(`old-role-${CLOSED}`));
+  assert.equal(res.code, 200);
+  assert.ok(res.body.includes('noindex'));
+  assert.ok(!res.body.includes('JobPosting'));
+});
+
+test('unknown job is 200 + noindex, never a hard 404', async () => {
+  const res = await call(job, jobReq(`gone-${'d'.repeat(24)}`));
+  assert.equal(res.code, 200);
+  assert.ok(res.body.includes('noindex'));
+});
+
+test('sitemap lists static pages and slugged job URLs', async () => {
+  const res = await call(sitemap, {});
+  assert.match(res.headers['Content-Type'], /xml/);
+  assert.ok(res.body.includes(`https://velaivaaipu.in/job/react-dev-pondicherry-${OPEN}`));
+  assert.ok(res.body.includes('https://velaivaaipu.in/for-colleges'));
+});
diff --git a/client/api/_lib.js b/client/api/_lib.js
new file mode 100644
index 0000000..9096d11
--- /dev/null
+++ b/client/api/_lib.js
@@ -0,0 +1,70 @@
+// Shared helpers for the SEO serverless functions (Vercel, ES modules). Files starting with "_" are not routes.
+const SITE_URL = (process.env.SITE_URL || 'https://velaivaaipu.in').replace(/\/$/, '');
+const API_URL = (process.env.API_BASE_URL || process.env.VITE_API_BASE_URL || '').replace(/\/$/, '');
+const API_DOMAIN = (process.env.VITE_API_DOMAIN || API_URL.replace(/\/api$/, '')).replace(/\/$/, '');
+const OG_IMAGE = `${SITE_URL}/og-default.png`;
+
+const escapeHtml = (value) => String(value ?? '')
+  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+
+const stripHtml = (value) => String(value ?? '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
+const clip = (text, max) => (text.length > max ? `${text.slice(0, max - 1).replace(/\s+\S*$/, '')}…` : text);
+
+const slugify = (text) => String(text ?? '')
+  .toLowerCase().normalize('NFKD').replace(/[^\w\s-]/g, '').trim().replace(/[\s_]+/g, '-').replace(/-+/g, '-').slice(0, 60);
+
+const OBJECT_ID = /([a-f0-9]{24})$/i;
+const jobIdFromSlug = (slug) => (String(slug || '').match(OBJECT_ID) || [])[1] || '';
+const jobUrl = (job) => {
+  const parts = [slugify(job.title), slugify(job.location)].filter(Boolean).join('-');
+  return `${SITE_URL}/job/${parts ? `${parts}-` : ''}${job._id || job.id}`;
+};
+
+const absolute = (url) => (!url ? '' : /^https?:/i.test(url) ? url : `${API_DOMAIN}${url}`);
+
+const getJson = async (path) => {
+  const response = await fetch(`${API_URL}${path}`, { headers: { Accept: 'application/json' } });
+  return { status: response.status, data: response.ok ? await response.json() : null };
+};
+
+// The built single-page app shell, fetched from this same deployment's home page.
+const getShell = async (req) => {
+  const host = req.headers['x-forwarded-host'] || req.headers.host;
+  const response = await fetch(`https://${host}/`, { headers: { 'x-seo-shell': '1' } });
+  return response.text();
+};
+
+// Replaces / adds head tags in the SPA shell so crawlers and link previews see them without running JS.
+const injectHead = (html, { title, description, canonical, robots = 'index, follow', image = OG_IMAGE, type = 'website', jsonLd }) => {
+  const t = escapeHtml(title);
+  const d = escapeHtml(description);
+  let out = html
+    .replace(/<title>[\s\S]*?<\/title>/i, `<title>${t}</title>`)
+    .replace(/<meta\s+name="description"[^>]*>\s*/i, '')
+    .replace(/<link\s+rel="canonical"[^>]*>\s*/i, '')
+    .replace(/<meta\s+name="robots"[^>]*>\s*/i, '')
+    .replace(/<meta\s+property="og:[^>]*>\s*/gi, '')
+    .replace(/<meta\s+name="twitter:[^>]*>\s*/gi, '');
+  const tags = [
+    `<meta name="description" content="${d}" />`,
+    `<meta name="robots" content="${escapeHtml(robots)}" />`,
+    `<link rel="canonical" href="${escapeHtml(canonical)}" />`,
+    `<meta property="og:site_name" content="Velaivaaipu" />`,
+    `<meta property="og:type" content="${escapeHtml(type)}" />`,
+    `<meta property="og:title" content="${t}" />`,
+    `<meta property="og:description" content="${d}" />`,
+    `<meta property="og:url" content="${escapeHtml(canonical)}" />`,
+    `<meta property="og:image" content="${escapeHtml(image)}" />`,
+    `<meta name="twitter:card" content="summary_large_image" />`,
+    `<meta name="twitter:title" content="${t}" />`,
+    `<meta name="twitter:description" content="${d}" />`,
+    `<meta name="twitter:image" content="${escapeHtml(image)}" />`,
+  ];
+  if (jsonLd) {
+    const json = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
+    tags.push(`<script type="application/ld+json" data-velaivaaipu-schema="true">${json}</script>`);
+  }
+  return out.replace(/<\/head>/i, `${tags.join('\n    ')}\n  </head>`);
+};
+
+export { SITE_URL, API_URL, OG_IMAGE, escapeHtml, stripHtml, clip, slugify, jobIdFromSlug, jobUrl, absolute, getJson, getShell, injectHead };
diff --git a/client/api/job.js b/client/api/job.js
new file mode 100644
index 0000000..fc68565
--- /dev/null
+++ b/client/api/job.js
@@ -0,0 +1,90 @@
+// GET /job/<slug>-<id>  (rewritten here by vercel.json)
+// Returns the normal single-page app, but with the job's title, description, Open Graph tags and
+// JobPosting JSON-LD already in the HTML — what Google, WhatsApp and Facebook read.
+import * as lib from './_lib.js';
+
+export default async function handler(req, res) {
+  try {
+    const id = lib.jobIdFromSlug(req.query.slug);
+    const shell = await lib.getShell(req);
+    res.setHeader('Content-Type', 'text/html; charset=utf-8');
+
+    if (!id || !lib.API_URL) {
+      res.setHeader('Cache-Control', 'public, s-maxage=60');
+      return res.status(200).send(shell);
+    }
+
+    const { status, data: job } = await lib.getJson(`/jobs/${id}`);
+
+    // Job missing or API unreachable: serve the app untouched and keep it out of the index.
+    if (status !== 200 || !job) {
+      const html = lib.injectHead(shell, {
+        title: 'Job not available | Velaivaaipu',
+        description: 'This job is no longer available. Browse the latest jobs in Tamil Nadu on Velaivaaipu.',
+        canonical: `${lib.SITE_URL}/jobs`,
+        robots: 'noindex, follow',
+      });
+      res.setHeader('Cache-Control', 'public, s-maxage=60');
+      return res.status(200).send(html);
+    }
+
+    const company = job.company?.name || 'Velaivaaipu';
+    const city = job.location || 'Tamil Nadu';
+    const canonical = lib.jobUrl(job);
+    const image = job.company?.logo ? lib.absolute(job.company.logo) : lib.OG_IMAGE;
+    const image2 = /\.(png|jpe?g)$/i.test(image) ? image : lib.OG_IMAGE; // WhatsApp ignores webp/svg previews
+
+    // Closed / filled job: keep the URL alive with a clear message, but drop the JobPosting markup.
+    if (job.closed) {
+      const html = lib.injectHead(shell, {
+        title: `${job.title || 'This job'} — position filled | Velaivaaipu`,
+        description: `This ${job.title || ''} opening at ${company} has been filled. Find similar jobs in ${city} on Velaivaaipu.`,
+        canonical,
+        robots: 'noindex, follow',
+      });
+      res.setHeader('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
+      return res.status(200).send(html);
+    }
+
+    const description = lib.clip(
+      `${company} is hiring ${job.title} in ${city}. ${job.vacancies || 1} opening${job.vacancies === 1 ? '' : 's'}. Apply free on Velaivaaipu. ${lib.stripHtml(job.description)}`,
+      155
+    );
+
+    const jsonLd = {
+      '@context': 'https://schema.org',
+      '@type': 'JobPosting',
+      title: job.title,
+      description: job.description || `${company} is hiring ${job.title} in ${city}.`,
+      identifier: { '@type': 'PropertyValue', name: 'Velaivaaipu', value: job.display_id || job._id },
+      datePosted: job.createdAt,
+      validThrough: job.validThrough,
+      employmentType: String(job.jobType || 'FULL_TIME').toUpperCase().replace(/[ -]/g, '_'),
+      hiringOrganization: { '@type': 'Organization', name: company, ...(job.company?.website ? { sameAs: job.company.website } : {}), ...(job.company?.logo ? { logo: lib.absolute(job.company.logo) } : {}) },
+      jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: city, addressRegion: 'Tamil Nadu', addressCountry: 'IN' } },
+      directApply: true,
+      ...(job.workMode === 'Remote' ? { jobLocationType: 'TELECOMMUTE', applicantLocationRequirements: { '@type': 'Country', name: 'IN' } } : {}),
+      ...(!job.salary?.isRangeHidden && job.salary?.min ? { baseSalary: { '@type': 'MonetaryAmount', currency: job.salary.currency || 'INR', value: { '@type': 'QuantitativeValue', minValue: job.salary.min, maxValue: job.salary.max || job.salary.min, unitText: 'YEAR' } } } : {}),
+    };
+
+    const html = lib.injectHead(shell, {
+      title: lib.clip(`${job.title} Job in ${city} — ${company} | Velaivaaipu`, 70),
+      description,
+      canonical,
+      image: image2,
+      type: 'article',
+      jsonLd,
+    });
+    res.setHeader('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
+    return res.status(200).send(html);
+  } catch (err) {
+    // Never break the page: fall back to the plain app.
+    try {
+      const shell = await lib.getShell(req);
+      res.setHeader('Content-Type', 'text/html; charset=utf-8');
+      return res.status(200).send(shell);
+    } catch {
+      return res.status(502).send('Temporarily unavailable');
+    }
+  }
+}
