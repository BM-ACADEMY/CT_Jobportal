+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { canSelfDelete, buildAnonymisePatch, confirmationProblem } = require('../../utils/accountDeletion');
+
+test('students, recruiters and team members may delete themselves', () => {
+  for (const role of ['jobseeker', 'recruiter', 'org_employee', 'drive_incharge']) assert.equal(canSelfDelete({ role }).ok, true);
+});
+test('organisation owners and admins are sent to support', () => {
+  for (const role of ['company', 'college', 'admin', 'subadmin']) assert.equal(canSelfDelete({ role }).ok, false);
+  assert.equal(canSelfDelete({ role: 'recruiter', ownsCompany: true }).ok, false);
+  assert.equal(canSelfDelete({ role: 'jobseeker', ownsCollege: true }).ok, false);
+});
+test('anonymise patch clears personal data and blocks login', () => {
+  const p = buildAnonymisePatch('abc123', new Date('2026-11-02T00:00:00Z'));
+  assert.equal(p.$set.email, 'deleted-abc123@deleted.invalid');
+  assert.equal(p.$set.name, 'Deleted user');
+  assert.equal(p.$set.isDeleted, true);
+  assert.equal(p.$set['profile.phone'], '');
+  assert.deepEqual(p.$set['profile.documents'], []);
+  assert.equal(p.$set['emailPrefs.marketingOptOut'], true);
+  for (const k of ['password', 'otp', 'googleId', 'githubId', 'linkedinId']) assert.equal(p.$unset[k], 1);
+});
+test('confirmation needs DELETE and the password when one exists', () => {
+  assert.match(confirmationProblem({ confirm: 'delete', hasPassword: false }), /DELETE/);
+  assert.match(confirmationProblem({ confirm: 'DELETE', hasPassword: true, passwordMatches: false }), /password/);
+  assert.equal(confirmationProblem({ confirm: 'DELETE', hasPassword: true, passwordMatches: true }), null);
+  assert.equal(confirmationProblem({ confirm: ' DELETE ', hasPassword: false }), null);
+});
diff --git a/server/utils/accountDeletion.js b/server/utils/accountDeletion.js
new file mode 100644
index 0000000..611fedd
--- /dev/null
+++ b/server/utils/accountDeletion.js
@@ -0,0 +1,50 @@
+// Self-service account deletion: what may be deleted by the person, and what the account becomes afterwards.
+// The row stays (applications, payments and receipts refer to it) but holds no personal data.
+const SELF_DELETE_BLOCKED_ROLES = ['admin', 'subadmin', 'company', 'college'];
+
+// Returns { ok: true } or { ok: false, msg }.
+const canSelfDelete = ({ role, ownsCompany = false, ownsCollege = false }) => {
+  if (SELF_DELETE_BLOCKED_ROLES.includes(role) || ownsCompany || ownsCollege) {
+    return { ok: false, msg: 'Organisation and admin accounts are closed by our team so that jobs, payments and people are handled properly. Please write to support@velaivaaipu.in from your registered email.' };
+  }
+  return { ok: true };
+};
+
+// The MongoDB update that removes personal data. userId is used for a unique, unusable email.
+const buildAnonymisePatch = (userId, now = new Date()) => ({
+  $set: {
+    name: 'Deleted user',
+    email: `deleted-${String(userId)}@deleted.invalid`,
+    avatar: '',
+    coverPic: '',
+    isVerified: false,
+    isDeleted: true,
+    deletedAt: now,
+    'profile.headline': '',
+    'profile.phone': '',
+    'profile.location': '',
+    'profile.bio': '',
+    'profile.skills': [],
+    'profile.qualification': [],
+    'profile.experience': [],
+    'profile.interestedDomain': [],
+    'profile.shifts': [],
+    'profile.preferredRole': '',
+    'profile.resumeUrl': '',
+    'profile.resumeName': '',
+    'profile.portfolioUrl': '',
+    'profile.documents': [],
+    'emailPrefs.marketingOptOut': true,
+    'emailPrefs.optOutAt': now,
+  },
+  $unset: { password: 1, otp: 1, otpExpiry: 1, googleId: 1, githubId: 1, linkedinId: 1 },
+});
+
+// Confirmation rules: the word DELETE must be typed; people who have a password must also give it.
+const confirmationProblem = ({ confirm, hasPassword, passwordMatches }) => {
+  if (String(confirm || '').trim() !== 'DELETE') return 'Type DELETE to confirm.';
+  if (hasPassword && !passwordMatches) return 'The password is not correct.';
+  return null;
+};
+
+module.exports = { canSelfDelete, buildAnonymisePatch, confirmationProblem, SELF_DELETE_BLOCKED_ROLES };
