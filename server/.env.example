NODE_ENV=production
PORT=5000
MONGODB_URI=
# 32+ random characters (e.g. `openssl rand -hex 32`). The server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=30d
FRONTEND_URL=https://velaivaaipu.in
ALLOWED_ORIGINS=https://velaivaaipu.in,https://www.velaivaaipu.in,https://admin.velaivaaipu.in

# First admin (only used when no admin exists; remove ADMIN_PASSWORD afterwards)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.velaivaaipu.in/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://api.velaivaaipu.in/api/auth/linkedin/callback

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: require a login token to open resumes/MoUs/reports under /uploads
# (turn on only after the client links documents with ?token=)
# true: documents (resumes, MoUs, reports, KYC) open only through short-lived signed links or a signed-in request.
# The client is ready for this (see client/src/utils/signedFiles.js); test resume, MoU and KYC links, then turn it on.
PROTECT_DOCUMENT_UPLOADS=false

# --- Campus course follow-up over WhatsApp (OFF by default) ---
# Turn on only after Meta approves the template named below.
WHATSAPP_FOLLOWUP_ENABLED=false
WA_TEMPLATE_COURSE_FOLLOWUP=course_followup_after_skill_test
COURSE_PAGE_URL=
COURSE_SCHOLARSHIP_ACTIVE=false
COURSE_SCHOLARSHIP_PRICE=2999
# Festival offer only: dates are YYYY-MM-DD (India time). Outside them the message offers a free counselling call.
# Deepavali 2026 is Sunday 8 Nov. Next windows: Pongal 8-18 Jan 2027, Tamil New Year 7-17 Apr 2027.
COURSE_SCHOLARSHIP_START=2026-10-30
COURSE_SCHOLARSHIP_END=2026-11-12
WHATSAPP_FOLLOWUP_DELAY_MIN=30
# App secret from the Meta app (Settings > Basic). Required for the STOP-reply handler.
WA_APP_SECRET=

# --- Lifecycle mails (OFF by default; see docs/LIFECYCLE_MAIL_PLAN.md) ---
LIFECYCLE_EMAILS_ENABLED=false
# Public base URL of this API, used for the one-click unsubscribe link. Mails are not sent without it.
API_PUBLIC_URL=https://api.velaivaaipu.in
# Footer shown on every lifecycle mail
FOOTER_ENTITY=Afra Ventures Private Limited
FOOTER_ADDRESS=78 Lenin St, Kosapalayam, Puducherry 605013
# Add the Velaivaaipu support phone / WhatsApp number once decided (left out of the footer while empty)
FOOTER_PHONE=
GSTIN=34ABGCA7083D1ZS
# Senders per audience (SMTP account must be allowed to send as these). LIFECYCLE_FROM is the fallback.
LIFECYCLE_FROM="Team Velai Vaaippu" <hello@velaivaaipu.in>
LIFECYCLE_FROM_SEEKER="Team Velai Vaaippu" <hello@velaivaaipu.in>
LIFECYCLE_FROM_COMPANY="Ilayapallavan from Velai Vaaippu" <hello@velaivaaipu.in>
LIFECYCLE_FROM_COLLEGE="Lokeshwari from Velai Vaaippu" <hello@velaivaaipu.in>
LIFECYCLE_MAX_PER_RUN=150
LIFECYCLE_MIN_STUDENTS=10

# --- Mail sending (see docs/EMAIL_DELIVERABILITY_PLAN.md) ---
# Visible sender for every mail that does not set its own. Keeps hello@velaivaaipu.in as the address people see
# and reply to, even when the SMTP login belongs to a relay service.
MAIL_FROM="Velaivaaipu" <hello@velaivaaipu.in>
MAIL_REPLY_TO=hello@velaivaaipu.in

# --- AI features (skill tests, resume review/builder, candidate matching) ---
# Every AI call goes through OpenRouter. Without this key the AI features fail.
OPENROUTER_API_KEY=

# --- SMTP (set these to switch app mail to the sending service) ---
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# USER_EMAIL=<service SMTP login>
# USER_PASS=<service SMTP key>
# The TLS certificate is verified. Emergency switch only, leave unset: SMTP_TLS_INSECURE=true

# --- Free plan safety net (only used if the Free plan row is missing from the database) ---
# DEFAULT_FREE_JOB_LIMIT=2
# DEFAULT_FREE_SEARCH_LIMIT=10

# --- Mail-service webhook (bounces and complaints). Long random string, also put in the Brevo webhook URL ---
# BREVO_WEBHOOK_SECRET=

# --- Relevance engine (utils/relevance.js). OFF by default; on = "jobs for you" is ranked by score with a why-list ---
# RELEVANCE_ENGINE_ENABLED=false

# --- AI assistant for job seekers (OFF by default). Needs a provider key AND a model name; no model is built in. ---
# ASSISTANT_ENABLED=false
# AI_PROVIDER_ASSISTANT=openai          # openai | openrouter
# OPENAI_API_KEY=
# OPENAI_ASSISTANT_MODEL=               # set to the model you have chosen; changing it needs no code change
# OPENROUTER_ASSISTANT_MODEL=           # only if AI_PROVIDER_ASSISTANT=openrouter
# ASSISTANT_DAILY_LIMIT=30              # messages per person per day
# ASSISTANT_MONTHLY_TOKEN_BUDGET=2000000  # all people; alarm at 80 percent, hard stop at 100 percent
