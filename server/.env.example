NODE_ENV=production
PORT=5000
MONGODB_URI=
# 32+ random characters (e.g. `openssl rand -hex 32`). The server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=30d
FRONTEND_URL=https://velaivaaipu.in
ALLOWED_ORIGINS=https://velaivaaipu.in,https://www.velaivaaipu.in,https://admin.velaivaaipu.in

# First admin (only used when no admin exists; remove ADMIN_PASSWORD afterwards)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.velaivaaipu.in/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://api.velaivaaipu.in/api/auth/linkedin/callback

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: require a login token to open resumes/MoUs/reports under /uploads
# (turn on only after the client links documents with ?token=)
PROTECT_DOCUMENT_UPLOADS=false
