VITE_API_BASE_URL=https://api.velaivaaipu.in/api
VITE_API_DOMAIN=https://api.velaivaaipu.in
VITE_RAZORPAY_KEY_ID=

# Tracking (leave blank to disable). GA4 id looks like G-XXXXXXXXXX, Pixel id is the numeric dataset id.
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# Read at RUNTIME by the Vercel functions in client/api (job pages + sitemap).
# Set in Vercel > Project > Settings > Environment Variables.
# API_BASE_URL=https://api.velaivaaipu.in/api
# SITE_URL=https://velaivaaipu.in

# Shows the AI assistant wording in the Privacy Policy and Terms. Set to true ONLY when the server has ASSISTANT_ENABLED=true and the lawyer has approved the text.
# VITE_ASSISTANT_ENABLED=false
